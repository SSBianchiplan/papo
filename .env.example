# Copie para .env (NUNCA versione o .env). Gere os segredos com: ./ops/gen-secrets.sh >> .env
PAPO_VERSION=1.0.0

# Domínios (DNS A/AAAA apontando para este servidor; portas 80 e 443 abertas)
APP_DOMAIN=papo.exemplo.com
AUTH_DOMAIN=auth.exemplo.com
ACME_EMAIL=infra@exemplo.com
# URL pública do Keycloak. Padrão: https://AUTH_DOMAIN. Para servir o login no mesmo domínio do app
# (atrás de um proxy já existente, ver docker-compose.hub.yml): AUTH_URL=https://APP_DOMAIN/auth e KC_HTTP_RELATIVE_PATH=/auth
# AUTH_URL=
# KC_HTTP_RELATIVE_PATH=
# Redes que podem abrir o console do Keycloak (/admin), separadas por vírgula
ADMIN_IP_ALLOWLIST=127.0.0.1/32

# Anthropic
# A chave também pode ser cadastrada (e trocada) em Configuração → Administração; a do painel tem prioridade.
ANTHROPIC_API_KEY=
# Só para chaves que não pertencem a um workspace (ex.: sk-ant-usr-…): ID wrkspc_… do Console
ANTHROPIC_WORKSPACE_ID=
MODEL_QUICK=claude-haiku-4-5-20251001
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_COMPLEX=claude-opus-5-5
MODEL_ROUTER=claude-haiku-4-5-20251001

# Limites por usuário
DAILY_TOKEN_LIMIT=2000000
MESSAGES_PER_MINUTE=20

# Administrador inicial do Keycloak (troque a senha no primeiro acesso)
KEYCLOAK_ADMIN_USER=admin

# --- segredos (preenchidos por ops/gen-secrets.sh) ---
# POSTGRES_PASSWORD=
# PAPO_OWNER_PASSWORD=
# PAPO_APP_PASSWORD=
# KEYCLOAK_DB_PASSWORD=
# KEYCLOAK_ADMIN_PASSWORD=
# REDIS_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# SECRETS_KEY=
# HUBGW_TOKEN=

# Gestão de contas: segredo do cliente confidencial "papo-users" (service account com view/query/manage-users do realm papo)
# KC_ADMIN_CLIENT_SECRET=
