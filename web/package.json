    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.4.4",
    "tailwindcss": "4.1.18",
    "typescript": "5.7.2",
    "vite": "6.4.5"
  }
