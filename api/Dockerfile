# syntax=docker/dockerfile:1.7
FROM python:3.12.8-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN useradd --system --uid 10001 --home /app papo
WORKDIR /app
COPY pyproject.toml constraints.txt ./
RUN pip install --upgrade pip==26.2.2 && pip install -c constraints.txt .
COPY alembic.ini ./
COPY migrations ./migrations
COPY app ./app
USER papo
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz',timeout=2).status==200 else 1)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*", "--workers", "2", "--no-server-header"]
