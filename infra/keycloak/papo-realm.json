{
  "realm": "papo",
  "enabled": true,
  "displayName": "Papo",
  "displayNameHtml": "Papo",
  "loginTheme": "papo",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 8,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR",
    "en"
  ],
  "defaultLocale": "pt-BR",
  "clients": [
    {
      "clientId": "papo-web",
      "name": "Papo (navegador)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://${APP_DOMAIN}/*"
      ],
      "webOrigins": [
        "https://${APP_DOMAIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${APP_DOMAIN}/*",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "audience papo-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "papo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "papo-api",
      "name": "Papo API (audiência)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false
    },
    {
      "clientId": "papo-users",
      "name": "Papo — gestão de contas",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "papo-admin",
        "description": "Administra a chave da IA, orçamento, limites e preços no Papo"
      },
      {
        "name": "papo-master",
        "description": "Administrador master do Papo: promove e rebaixa administradores"
      }
    ]
  }
}